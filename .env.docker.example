# ── Variables de entorno para Docker (Plantilla) ──────────────────
# Copia este archivo como .env.docker y ajusta los valores necesarios.

SECRET_KEY=cambia-este-valor-por-uno-largo-y-aleatorio
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DOMINIO_INSTITUCIONAL=inacapmail.cl

# La BD se conecta al servicio "db" del docker-compose (no localhost)
DATABASE_URL=postgres://leica:leica_segura_2024@db:5432/leica_inventario

# Búsqueda semántica con fastembed
BUSQUEDA_SEMANTICA=True

# Gemini AI (opcional: coloca tu API key para RAG generativo)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
GEMINI_MODELO_RESPALDO=gemini-3.1-flash-lite

URL_SITIO=http://localhost:8000

# Administrador (se crea automáticamente al arrancar si no existe)
ADMIN_EMAIL=encargado.leica@inacapmail.cl
ADMIN_PASSWORD=LeicaAdmin2024!

# Email (Servicio Mailpit dentro de Docker Compose)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL="LEICA Inventario <no-responder@inacapmail.cl>"

# Respaldos
POSTGRES_BIN=
RESPALDOS_DIR=/app/respaldos
RESPALDO_AUTOMATICO=False
RESPALDO_HORAS=24
RESPALDO_CONSERVAR=14

# SLAs y retención
EVALUACION_BUSQUEDA_DIAS=30
SLA_REVISION_HORAS=24
SLA_BAJA_DIAS=5
PRIVACIDAD_CONTACTO=
PLAZO_DERECHOS_DIAS=30
RETENCION_BUSQUEDAS_DIAS=365
RETENCION_EVENTOS_DIAS=365
